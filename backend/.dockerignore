# ============================================================
#  Build context TIDAK boleh memuat rahasia / data lokal.
#  (Kalau tidak ada file ini, `COPY . .` akan membawa .env ke
#   dalam image dan nilainya bisa dibaca lewat layer image.)
# ============================================================

# Environment / secrets — dikirim saat runtime oleh docker-compose
.env
.env.*
*.env
!.env.example

# Dependency & log (di-install ulang di dalam image)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Data runtime & file upload user (dipasang lewat bind mount, bukan dari image)
#
# public/uploads di-mount oleh docker-compose dari ./backend/public/uploads,
# jadi TIDAK perlu ikut ke image. Mengecualikannya di sini:
#   - menghemat ± 277 MB per image
#   - `docker compose build` jauh lebih cepat
#   - file upload tetap bisa diakses (dari bind mount, bukan dari image)
public/uploads

# Arsip cadangan uploads (± 35 MB). Tidak dipakai kode dan tidak diserve
# (server.js hanya melayani /uploads, bukan seluruh folder public).
# Lihat juga .gitignore: backend/public/uploads.zip
public/uploads.zip

data
logs
*.log

# Tooling / VCS
.git
.gitignore
.dockerignore
Dockerfile
*.md
.continue
.vscode
