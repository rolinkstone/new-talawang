# ============================================================
#  Build context TIDAK boleh memuat rahasia / data lokal.
#  (Kalau tidak ada file ini, `COPY . .` akan membawa .env ke
#   dalam image dan nilainya bisa dibaca lewat layer image.)
# ============================================================

# Environment / secrets — dikirim saat runtime oleh docker-compose
.env
.env.*
*.env
!.env.example

# Dependency & log (di-install ulang di dalam image)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Data runtime (dipasang lewat volume, bukan dari image)
data
logs
*.log

# ⚠️ public/uploads SENGAJA TIDAK di-ignore di sini.
#    Folder ini ikut di-build ke image sebagai "seed" supaya file upload
#    lokal bisa ikut terkirim ke server (lihat backend/entrypoint.sh).
#    Agar data user di server tetap aman, Dockerfile menyalinnya ke
#    /seed/uploads (di luar path yang di-mount) dan seed hanya dipakai
#    saat volume ./data/backend/uploads masih kosong.

# Tooling / VCS
.git
.gitignore
.dockerignore
Dockerfile
*.md
.continue
.vscode
