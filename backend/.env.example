DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
KEYCLOAK_SERVER_URL=https://auth.example.com
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your_admin_password
# Client OIDC aplikasi — secret WAJIB dirotasi (jangan pernah hardcode di kode)
KEYCLOAK_CLIENT_ID=nextjs-local
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
# Daftar audience (client id) yang diizinkan untuk verifikasi JWT, dipisah koma
KEYCLOAK_AUDIENCES=nextjs-local,talawang
# Origin frontend yang diizinkan untuk CORS (bisa lebih dari satu, dipisah koma)
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001
# Kunci rahasia — WAJIB diganti nilai acak kuat (min. 32 karakter)
SESSION_SECRET=generate_a_strong_random_secret
JWT_SECRET=generate_a_strong_random_secret
SIGNED_URL_SECRET=generate_a_strong_random_secret
NODE_ENV=production
PORT=5000
