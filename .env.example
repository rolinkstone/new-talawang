# ============================================================
# .env.example — TALAWANG KEUANGAN (PRODUCTION / docker compose)
#
# Cara pakai di server:
#     cp .env.example .env     → lalu isi SEMUA nilai di bawah.
#
# File `.env` TIDAK boleh di-commit (sudah masuk .gitignore).
# File INI (root .env) hanya dipakai oleh `docker compose`.
# Untuk `npm run dev` di laptop, env tetap dibaca dari
#     backend/.env   dan   frontend/.env
# (lihat .env.example di masing-masing folder itu).
#
# Generate nilai acak kuat (contoh):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================

# ---------- Database MySQL (jalan di HOST server) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ganti_user_database
DB_PASSWORD=ganti_password_database_yang_kuat
DB_NAME=accounting

# ---------- Keycloak ----------
KEYCLOAK_SERVER_URL=https://auth.contoh.id
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ganti_password_admin_keycloak
# Client OIDC aplikasi (RAHASIA — jangan pernah ditulis di kode/compose)
KEYCLOAK_CLIENT_ID=nextjs-local
KEYCLOAK_CLIENT_SECRET=ganti_client_secret
KEYCLOAK_AUDIENCES=nextjs-local,talawang
# Dipakai frontend (NextAuth). Harus = {KEYCLOAK_SERVER_URL}/realms/{realm}
KEYCLOAK_ISSUER=https://auth.contoh.id/realms/master

# ---------- Rahasia aplikasi (WAJIB acak, min. 32 karakter) ----------
SESSION_SECRET=ganti_random_kuat_1
JWT_SECRET=ganti_random_kuat_2
SIGNED_URL_SECRET=ganti_random_kuat_3
NEXTAUTH_SECRET=ganti_random_kuat_4

# ---------- URL publik (WAJIB domain asli, BUKAN localhost) ----------
# NEXT_PUBLIC_* TER-BAKE saat `docker compose build` → ubah di sini lalu rebuild.
NEXT_PUBLIC_API_URL=https://keuangan.contoh.id/api
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.contoh.id/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nextjs-local
# Dipakai NextAuth (server-side). HARUS sama dengan domain yang dipakai browser.
NEXTAUTH_URL=https://keuangan.contoh.id
# Dipakai backend/server.js untuk redirect setelah logout.
FRONTEND_URL=https://keuangan.contoh.id
# Origin browser yang diizinkan (CORS).
CORS_ORIGIN=https://keuangan.contoh.id

# ---------- Port & zona waktu ----------
# Backend memakai network_mode: host → PORT_BACKEND = port DI HOST.
PORT_BACKEND=5000
# Frontend hanya bind ke 127.0.0.1:${PORT_FRONTEND} lalu diteruskan nginx.
# Port DI DALAM container tetap 3001 (dikunci "next start -p 3001").
PORT_FRONTEND=3001
TZ=Asia/Jakarta

# ---------- Opsional ----------
# Isi "true" untuk mematikan rate limiter. JANGAN di production.
RATE_LIMIT_DISABLED=false
